  secondary_ball_mill --> cycloner_refractory_right
  cycloner_refractory_right -->|"underflow"| secondary_ball_mill
  cycloner_refractory_right -->|"overflow"| refractory_thickener
  refractory_thickener -->|"underflow"| acidulation_starter_tank
  refractory_thickener -->|"overflow"| return_water_refractory

  %% Carbon-in Leach
  lime --> lime_silo
  lime_silo -->|"Lime"| neutralization_tank
  neutralization_tank --> vent_neutralization
  air_tailor --> tailor_mill
  return_water_tailor --> tailor_mill
  tailor_mill --> neutralization_tank
  neutralization_tank --> cil_tank
