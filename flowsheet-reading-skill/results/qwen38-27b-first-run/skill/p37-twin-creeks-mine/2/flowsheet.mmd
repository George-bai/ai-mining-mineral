  oxide_thickener -->|"underflow"| neutralization_tank
  oxide_thickener -->|"overflow"| water_tank_oxide
  water_tank_oxide --> water_return_oxide

  %% Refractory Grinding
  sag_mill_refractory --> screen_refractory
