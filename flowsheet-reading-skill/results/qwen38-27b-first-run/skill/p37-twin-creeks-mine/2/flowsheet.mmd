  heat_exchanger --> barren_salt_tank
  caustic --> barren_salt_tank
  pregnant_salt_tank --> electrorefining_cell
  electrorefining_cell --> vent_electrorefining
  electrorefining_cell --> rotor
  rotor --> furnace
  furnace --> gold_bullion
