  air_cil --> screen_cil
  screen_cil --> sub_aerial_deposition
  cil_tank --> sub_aerial_deposition
  sub_aerial_deposition --> tailings
  sub_aerial_deposition --> reclaim_water
  cil_tank --> loaded_carbon_screen
  loaded_carbon_screen --> surge_tank_cil
  surge_tank_cil --> acid_wash_tank

  %% Pressure Oxidation
  sulfuric_acid --> acidulation_starter_tank
  sulfuric_acid --> vent_sulfuric
  sulfuric_acid --> to_atmosphere_sulfuric
  air_acidulation --> acidulation_starter_tank
  acidulation_starter_tank --> two_stage_slurry_heater
  two_stage_slurry_heater --> four_stage_autoclave
  four_stage_autoclave --> two_stage_flash_vessel
  four_stage_autoclave --> autoclave_oxygen
  four_stage_autoclave --> steam
  steam --> steam_generation_plant
  natural_gas --> steam_generation_plant
  steam_generation_plant --> to_atmosphere_steam

  %% Refractory Slurry Cooling
  two_stage_flash_vessel --> second_flash_vessel
  two_stage_flash_vessel --> vent_gas_scrubber
  two_stage_flash_vessel -->|"recycle"| two_stage_slurry_heater
  two_stage_flash_vessel -->|"recycle"| four_stage_autoclave
  second_flash_vessel --> cooling_tower
  second_flash_vessel --> tube_shell_cooler
  water_scrubber --> vent_gas_scrubber
  vent_gas_scrubber --> to_atmosphere_scrubber
  cooling_water --> cooling_tower
  cooling_tower --> surge_tank_cooling
  surge_tank_cooling --> tube_shell_cooler

  %% Carbon Stripping, Reactivation, & Sizing
  nitric_acid --> acid_wash_tank
  acid_wash_tank --> carbon_strip_vessel
  carbon_strip_vessel --> carbon_tank
  carbon_strip_vessel --> heat_exchanger
  kiln_feed_screen --> reactivation_kiln
  reactivation_kiln --> quench_tank
  quench_tank --> carbon_wash_screen
  carbon_wash_screen --> carbon_tank
  carbon_wash_screen --> carbon_fines_tail_filter
  carbon_wash_screen --> kiln_feed_screen
  carbon_tank --> heater
  heater --> heat_exchanger
