    concentrateMarket["CONCENTRATE TO MARKET<br/>38,880 TONS/YR (AVG @ 25% Cu)<br/>19,934,000 LB/YR Cu<br/>150,000 OZ/YR Au<br/>1,418,100 OZ/YR Ag"]
    secondCleanerScav["2ND CLEANER SCAVENGER"]

    magneticSeparation --> copperThickener
