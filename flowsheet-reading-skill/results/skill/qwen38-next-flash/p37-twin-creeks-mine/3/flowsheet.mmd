  %% ---- oxide crushing and grinding ----
  rom_oxide_ore --> oxide_crusher_hopper
  oxide_crusher_hopper --> jaw_crusher
  jaw_crusher --> radial_stacker
  radial_stacker --> oxide_stockpile
  oxide_stockpile --> wheel_loader
  wheel_loader --> oxide_grinding_hopper
  oxide_grinding_hopper --> oxide_sag_mill
  oxide_return_water -->|"Return Water"| oxide_sag_mill
  oxide_return_water -->|"Return Water"| oxide_sag_screen
  oxide_sag_mill --> oxide_sag_screen
  oxide_sag_screen --> oxide_sump
  oxide_sump --> oxide_cyclone
  oxide_cyclone -->|"underflow"| oxide_ball_mill
  oxide_cyclone -->|"overflow"| oxide_trash_screen
  oxide_ball_mill --> oxide_sump
  oxide_trash_screen --> oxide_thickener
  oxide_thickener --> oxide_return_water_tank
  oxide_return_water_tank --> water_return_oxide

  %% ---- refractory grinding ----
  rom_refractory_ore --> ore_blend_stockpiles
  ore_blend_stockpiles --> front_end_loader
  front_end_loader --> refractory_hopper
  refractory_hopper --> refractory_sag_mill
  refractory_return_water -->|"Return Water"| refractory_sag_mill
  refractory_return_water -->|"Return Water"| refractory_sag_screen
  refractory_return_water -->|"Return Water"| refractory_sump_b
  refractory_sag_mill --> refractory_sag_screen
  refractory_sag_screen -->|"oversize"| refractory_sag_mill
  refractory_sag_screen --> refractory_sump_a
  refractory_sump_a --> primary_cyclone
  primary_cyclone -->|"underflow"| primary_ball_mill
  primary_cyclone -->|"overflow"| refractory_trash_screen
  primary_ball_mill --> refractory_sump_a
  refractory_trash_screen --> refractory_sump_b
  refractory_sump_b --> secondary_cyclone
  secondary_cyclone -->|"underflow"| secondary_ball_mill
  secondary_cyclone -->|"overflow"| refractory_thickener
  secondary_ball_mill --> refractory_trash_screen
  refractory_thickener --> refractory_return_water_tank
  refractory_return_water_tank --> water_return_refractory
  water_return_refractory -->|"Water Return to Refractory Circuit"| refractory_thickener

  %% ---- pressure oxidation ----
  refractory_thickener --> acidulation_tanks
  sulfuric_acid -->|"Sulfuric Acid"| acidulation_tanks
  air_acidulation -->|"Air"| acidulation_tanks
  acidulation_tanks -->|"vent gas"| vent_scrubber_column
  vent_scrubber_column -->|"To Atmosphere"| to_atmosphere_acid
  acidulation_tanks --> slurry_heater_1
  slurry_heater_1 --> slurry_heater_2
  slurry_heater_2 --> autoclave
  oxygen -->|"Oxygen"| autoclave
  natural_gas -->|"Natural Gas"| steam_gen_plant
  steam_gen_plant -->|"Steam"| autoclave
  steam_gen_plant -->|"To Atmosphere"| steam_to_atmosphere
  autoclave --> flash_vessel_1
  flash_vessel_1 --> flash_vessel_2
  flash_vessel_1 -->|"flashed steam"| slurry_heater_1
  flash_vessel_2 -->|"flashed steam"| slurry_heater_2
  flash_vessel_2 --> pox_surge_tank
  autoclave -->|"vent gas"| vent_gas_scrubber
  flash_vessel_2 -->|"vent gas"| vent_gas_scrubber
  scrubber_water -->|"Water"| vent_gas_scrubber
  water_return_refractory -->|"Water Return to Refractory Circuit"| vent_gas_scrubber
  vent_gas_scrubber -->|"To Atmosphere"| to_atmosphere_scrubber

  %% ---- refractory slurry cooling ----
  pox_surge_tank --> tube_shell_coolers
  cooling_tower --> cooling_water
  cooling_water -->|"Cooling Water"| tube_shell_coolers
  tube_shell_coolers -->|"cooling water"| cooling_tower
  tube_shell_coolers --> neutralization_tanks
  cooling_water -->|"Cooling Water"| autoclave

  %% ---- carbon-in-leach ----
  lime_slurry_column --> lime_slurry_vent
  lime_slurry_column --> tower_mill
  return_water_tower -->|"Return Water"| tower_mill
  air_tower -->|"Air"| tower_mill
  tower_mill -->|"Lime"| neutralization_tanks
  oxide_thickener --> neutralization_tanks
  neutralization_tanks --> cil_tank_1
  air_cil -->|"Air"| cil_tank_1
  air_cil -->|"Air"| cil_tank_2
  cil_tank_1 --> cil_tank_2
  cil_tank_1 --> loaded_carbon_screen
  cil_tank_2 --> cil_screen
  cil_screen --> cil_sump
  cil_sump --> sub_aerial_deposition
  sub_aerial_deposition --> tailings
  sub_aerial_deposition -->|"Reclaim Water Return to Plant"| reclaim_water
  loaded_carbon_screen --> carbon_surge_tank
  carbon_surge_tank --> acid_wash_tank

  %% ---- carbon stripping, reactivation and sizing ----
  nitric_acid -->|"Nitric Acid"| acid_wash_tank
  acid_wash_tank --> carbon_strip_vessel
  carbon_strip_vessel --> carbon_tank
  carbon_strip_vessel --> heat_exchanger
  heat_exchanger --> pregnant_tank
  pregnant_tank --> el_cells
  el_cells --> barren_tank
  el_cells --> rotary
  el_cells --> el_vent
  caustic -->|"Cautic"| barren_tank
  barren_tank --> heat_exchanger
  heat_exchanger --> heater
  heater --> carbon_strip_vessel
  carbon_tank --> kiln_feed_screen
  kiln_feed_screen --> reactivation_kiln
  reactivation_kiln --> quench_tank
  quench_tank --> carbon_wash_screen
  carbon_wash_screen -->|"regenerated carbon"| cil_tank_1
  carbon_wash_screen --> carbon_fines_filter
  carbon_fines_filter --> rotary
  rotary --> furnace
  furnace --> gold_bullion
